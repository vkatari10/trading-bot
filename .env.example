# ALPACA API
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_ACCOUNT_LINK=https://paper-api.alpaca.markets/v2/account
ALPACA_POSITIONS_LINK=https://paper-api.alpaca.markets/v2/positions
ALPACA_ORDERS_LINK=https://paper-api.alpaca.markets/v2/orders
ALPACA_CLOCK_LINK=https://paper-api.alpaca.markets/v2/clock
ALPACA_MARKET_DATA_LINK=https://data.alpaca.markets/v2/stocks/bars/latest?symbols=

# RUNTIME ENGINE
REFRESH_RATE=60 # seconds
TICKER=AAPL 
BURN_IN_WINDOW_TIME=31 # (+1 if using delta, diff objects) | minutes
ENGINE_LOG_API_FLUSH_TIME=2000 # milliseconds # UNUSED
LOG_LINK=http://localhost:3000/api/log # logging events
DATA_LINK=http://localhost:3000/api/data # technical data at each loop
ENV_LINK=http://localhost:3000/api/env # once just the setting values
BROKER_LINK=http://localhost:3000/api/broker # broker account updates

# ML API
ML_API_LINK=http://127.0.0.1:5000

# ML PIPELINE
FEATURE_CONFIG_FILE=features.json
LABEL_CONFIG_FILE=signals.json
TRAIN_TICKER=AAPL # move to JSON configs (for multiple)
TRAIN_MODEL_TYPE=RandomForestClassifier # UNUSED
TRAIN_TIMEFRAME=1m # UNUSED
DUMP_MODEL_NAME=model.pkl # UNUSED
RUNTIME_MODEL_NAME=model.pkl # UNUSED


